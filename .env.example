# Porta do servidor (padrão: 3000)
PORT=3000

# Chave secreta para assinar os JWTs — use uma string longa e aleatória (mín. 32 caracteres)
CLIENT_TOKEN_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria

# Código de acesso exigido para cadastrar um administrador — nunca exponha esse valor
ADMIN_REGISTER_CODE=coloque_aqui_o_codigo_de_acesso_admin

# Token de acesso do Mercado Pago (testes começam com TEST-, produção com APP_USR-)
MP_ACCESS_TOKEN=coloque_aqui_o_token_do_mercado_pago
